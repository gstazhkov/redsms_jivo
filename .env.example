BOT_TOKEN=replace-with-a-long-random-secret
JIVO_PROVIDER_ID=replace-with-jivo-provider-id
PORT=8000
TIMEZONE=Europe/Moscow
WORK_START=9
WORK_END=19
WORK_DAYS=0,1,2,3,4

SUPPORT_DB_PATH=/var/lib/redsms-jivo/support.sqlite3
MAX_REQUEST_BYTES=1048576
TRUSTED_HOSTS=bot.example.com

OMNI_API_URL=https://your-account.omnidesk.ru
OMNI_STAFF_EMAIL=service-account@example.com
OMNI_API_KEY=replace-with-omnidesk-api-key
OMNI_WEBHOOK_TOKEN=replace-with-a-different-long-random-secret
OMNI_GROUP_ID=replace-with-group-id
# Optional; assign to a specific user as well as the group.
# OMNI_ASSIGNEE_STAFF_ID=replace-with-staff-id

# Optional Telegram alerts. Set both or leave both empty.
# TG_BOT_TOKEN=replace-with-telegram-bot-token
# TG_CHAT_ID=replace-with-telegram-chat-id

LOG_LEVEL=INFO